rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /assets/{allPaths=**} {
      // Allow public read access to the assets folder
      // This is necessary for sharing projects and recovering assets
      allow read: if true;
      
      // Only authenticated users can upload or delete assets
      allow write: if request.auth != null;
    }
    
    match /projects/{allPaths=**} {
      // Open project metadata for now as per firestore rules
      allow read, write: if true;
    }
  }
}
