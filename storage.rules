rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /assets/{allPaths=**} {
      // WIDE OPEN FOR TESTING: Anyone can read and upload assets
      allow read, write: if true;
    }
    
    match /projects/{allPaths=**} {
      // Open project metadata for now as per firestore rules
      allow read, write: if true;
    }
  }
}
