# Firebase web config. These values are public by design (security is enforced
# by firestore.rules / storage.rules), but use your own project's values.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OPTIONAL — self-hosted/private deployments only. Vite bakes this key into the
# compiled JS bundle, so anyone who can load your site can extract it. NEVER set
# this for a publicly hosted build; users can instead enter their own key in
# Settings (BYOK, stored in localStorage).
VITE_GEMINI_API_KEY=your_gemini_api_key
